  "components": {
    "schemas": {
      "Approval": {
        "type": "string",
        "enum": [
          "not_required",
          "pending",
          "approved",
          "denied"
        ],
        "title": "Approval"
      },
      "ApprovalResponse": {
        "properties": {
          "campaign_id": {
            "type": "string",
            "title": "Campaign Id"
          },
          "move": {
            "type": "integer",
            "title": "Move"
          },
          "approval": {
            "type": "string",
            "title": "Approval"
          }
        },
        "type": "object",
        "required": [
          "campaign_id",
          "move",
          "approval"
        ],
        "title": "ApprovalResponse"
      },
      "AuditEntry": {
        "properties": {
          "campaign_id": {
            "type": "string",
            "title": "Campaign Id"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Code"
          },
          "response_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Sha256"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "agent"
          }
        },
        "type": "object",
        "required": [
          "campaign_id",
          "at",
          "method",
          "url",
          "allowed"
        ],
        "title": "AuditEntry",
        "description": "Trilha append-only: toda requisicao (inclusive as bloqueadas)."
      },
      "Campaign": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "config": {
            "$ref": "#/components/schemas/CampaignConfig"
          },
          "state": {
            "$ref": "#/components/schemas/CampaignState",
            "default": "created"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "score": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Score"
              },
              {
                "type": "null"
              }
            ]
          },
          "moves": {
            "items": {
              "$ref": "#/components/schemas/Move"
            },
            "type": "array",
            "title": "Moves"
          }
        },
        "type": "object",
        "required": [
          "id",
          "config",
          "created_at"
        ],
        "title": "Campaign"
      },
      "CampaignConfig": {
        "properties": {
          "origin": {
            "type": "string",
            "title": "Origin",
            "description": "Origem exata: esquema + host + porta. Ex.: https://alvo.com"
          },
          "extra_origins": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Extra Origins",
            "description": "Origens adicionais em escopo (ex.: versao http:// para o lance de redirect)."
          },
          "included_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Included Paths"
          },
          "excluded_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Excluded Paths"
          },
          "allowed_profiles": {
            "items": {
              "$ref": "#/components/schemas/Profile"
            },
            "type": "array",
            "title": "Allowed Profiles"
          },
          "allowed_methods": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Methods"
          },
          "max_requests_per_second": {
            "type": "number",
            "title": "Max Requests Per Second",
            "default": 2.0
          },
          "max_total_requests": {
            "type": "integer",
            "title": "Max Total Requests",
            "default": 200
          },
          "request_timeout_s": {
            "type": "number",
            "title": "Request Timeout S",
            "default": 10.0
          },
          "window_start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Start"
          },
          "window_end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Window End"
          },
          "authorized_by": {
            "type": "string",
            "title": "Authorized By",
            "description": "Quem autorizou o teste"
          },
          "authorized_at": {
            "type": "string",
            "format": "date-time",
            "title": "Authorized At",
            "description": "Quando foi autorizado"
          }
        },
        "type": "object",
        "required": [
          "origin",
          "authorized_by",
          "authorized_at"
        ],
        "title": "CampaignConfig"
      },
      "CampaignState": {
        "type": "string",
        "enum": [
          "created",
          "running",
          "waiting_approval",
          "stopped",
          "finished",
          "failed"
        ],
        "title": "CampaignState"
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Confidence"
      },
      "CreateCampaignRequest": {
        "properties": {
          "config": {
            "$ref": "#/components/schemas/CampaignConfig"
          }
        },
        "type": "object",
        "required": [
          "config"
        ],
        "title": "CreateCampaignRequest"
      },
      "Event": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq",
            "default": 0
          },
          "campaign_id": {
            "type": "string",
            "title": "Campaign Id"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "move": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Move"
              },
              {
                "type": "null"
              }
            ]
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "campaign_id",
          "type",
          "at"
        ],
        "title": "Event"
      },
      "EventType": {
        "type": "string",
        "enum": [
          "campaign_started",
          "move_planned",
          "approval_requested",
          "approval_resolved",
          "test_started",
          "finding_created",
          "scope_blocked",
          "score_updated",
          "stop_requested",
          "campaign_finished"
        ],
        "title": "EventType"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "request": {
            "type": "string",
            "title": "Request",
            "description": "Ex.: \"GET / HTTP/1.1\""
          },
          "response_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Status"
          },
          "response_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Response Headers"
          },
          "response_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Sha256"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "id",
          "request"
        ],
        "title": "Evidence",
        "description": "Evidencia bruta. Segredos/cookies DEVEM chegar aqui ja mascarados."
      },
      "GameReview": {
        "properties": {
          "campaign": {
            "$ref": "#/components/schemas/Campaign"
          },
          "executive_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Executive Summary"
          },
          "key_moments": {
            "items": {
              "$ref": "#/components/schemas/KeyMoment"
            },
            "type": "array",
            "title": "Key Moments"
          },
          "audit": {
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            },
            "type": "array",
            "title": "Audit"
          }
        },
        "type": "object",
        "required": [
          "campaign"
        ],
        "title": "GameReview",
        "description": "Relatorio estilo Game Review do Chess.com."
      },
      "Grade": {
        "type": "string",
        "enum": [
          "brilliant",
          "great",
          "best",
          "good",
          "inaccuracy",
          "mistake",
          "miss",
          "blunder",
          "inconclusive"
        ],
        "title": "Grade",
        "description": "Notas estilo Chess.com. ``inconclusive`` fica fora do score."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeyMoment": {
        "properties": {
          "move": {
            "type": "integer",
            "title": "Move"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "move",
          "summary"
        ],
        "title": "KeyMoment"
      },
      "Move": {
        "properties": {
          "move": {
            "type": "integer",
            "title": "Move",
            "description": "Numero do lance (1-based)"
          },
          "test_id": {
            "type": "string",
            "title": "Test Id"
          },
          "title": {
            "type": "string",
