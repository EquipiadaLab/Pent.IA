          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "wstg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wstg",
            "examples": [
              "WSTG-SESS-02"
            ]
          },
          "owasp_top10": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owasp Top10",
            "examples": [
              "A07:2025"
            ]
          },
          "approval": {
            "$ref": "#/components/schemas/Approval",
            "default": "not_required"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "low"
          },
          "grade": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Grade"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Confidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "ai_explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
