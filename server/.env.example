# Copie para .env (NUNCA commite o .env). Sem credenciais reais aqui.

# --- AWS / Bedrock -----------------------------------------------------------
# Credenciais temporarias do evento (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN) so no .env. Permissao minima: bedrock:InvokeModel.
AWS_REGION=us-east-1
# Treinador, juiz e resumo (qualidade):
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# Planejador do agente (decide a cada lance: rapido):
PLANNER_MODEL_ID=us.anthropic.claude-haiku-5-5
# LLM_ENABLED=false   # desliga a IA (so regras)

# --- Alvo -------------------------------------------------------------------
# ALVO TRAVADO (recomendado): o sistema SO testa este endereco. Qualquer outra
# URL enviada pelo front e recusada (403). E a trava mais forte.
LOCKED_TARGET=https://3.migbot.com.br
# MODO LISTA FIXA (sem LOCKED_TARGET): aceita so os alvos desta lista.
# AUTHORIZED_TARGETS=https://alvo-autorizado.com
# MODO ABERTO (sem as duas acima): aceita qualquer URL publica; usa este padrao
# quando o front nao envia nada. Rede interna/privada sempre bloqueada (anti-SSRF).
DEFAULT_TARGET=https://3.migbot.com.br
# BLOCK_PRIVATE_TARGETS=true   # NAO desligue em servidor exposto (metadados da nuvem)

# --- Execucao automatica (ex.: todo dia 9h via n8n) ---------------------------
# Testes sensiveis que podem rodar SEM humano, quem autorizou e ate quando.
# O que nao estiver aqui e negado nas execucoes automaticas.
# PREAPPROVED_TESTS=FILE-001,FILE-002,ERR-001
# PREAPPROVED_BY=Nome do responsavel
# PREAPPROVED_UNTIL=2026-11-30

# --- Plataforma ---------------------------------------------------------------
DATABASE_URL=sqlite:///./pentest_chess.db
# Origens da tela (CORS e WebSocket). Use * para liberar qualquer origem
# (front hospedado em qualquer lugar; mais aberto, menos seguro):
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=*
